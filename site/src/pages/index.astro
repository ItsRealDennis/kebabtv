---
import Base from "../layouts/Base.astro";
import { videos, stats, fmtDate, fmtDur, fmtScore, fmtNum, placeName, placeSub, scoreColor, scoreInk } from "../lib/data";

// Channel list for the TV, newest first. Kept small: only what the screen needs.
const chans = videos.map((v) => ({
  id: v.id, ep: v.ep, thumb: v.thumb, name: placeName(v), sub: placeSub(v),
  score: v.score, place: v.place ?? null, date: fmtDate(v.date),
}));

const scored = videos.filter((v) => v.score != null);
const top = [...scored].sort((a, b) => b.score! - a.score!)[0];
const newest = videos[0];
const mostTalked = [...videos].sort((a, b) => (b.comments ?? 0) - (a.comments ?? 0))[0];

const byYear = new Map<string, typeof videos>();
for (const v of videos) {
  const y = v.date?.slice(0, 4) ?? "Ukendt";
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(v);
}
const first = chans[0];
---
<Base channel={1} bodyClass="home">
  <section class="stage wrap" aria-label="Fjernsynet">
    <div class="tv" id="tv">
      <div class="tv__screen" id="screen" data-ep={first?.ep}>
        {first ? (
          <>
            <img class="tv__img" id="tv-img" src={first.thumb} alt="" width="1280" height="720" fetchpriority="high" />
            <div class="tv__player" id="tv-player" hidden></div>
            <div class="tv__osd" id="tv-osd" aria-live="polite"><span>KAN</span> <b id="tv-ch">{first.ep}</b></div>
            <div class="tv__score" id="tv-score" style={`--c:${scoreColor(first.score)};--i:${scoreInk(first.score)}`}>
              <span id="tv-score-v">{fmtScore(first.score)}</span>
            </div>
          </>
        ) : (
          <p class="tv__empty">Ingen signal. Kør <code>python bot/run.py</code> for at hente videoerne.</p>
        )}
        <canvas class="tv__static" id="tv-static" width="160" height="90" aria-hidden="true"></canvas>
        <div class="tv__glass" aria-hidden="true"></div>
      </div>
      <div class="tv__chin">
        <p class="tv__now" id="tv-lt" aria-live="polite"><b id="tv-name">{first?.name}</b> <span id="tv-sub">{first?.sub}</span></p>
        <span class="tv__knob" aria-hidden="true"></span><span class="tv__knob" aria-hidden="true"></span>
      </div>
    </div>

    <div class="remote" role="group" aria-label="Fjernbetjening">
      <div class="remote__led" id="led" aria-hidden="true"></div>
      <button class="rk rk--ok" id="btn-play" type="button" aria-label="Se afsnittet">▶</button>
      <div class="remote__row">
        <button class="rk" id="btn-prev" type="button" aria-label="Forrige kanal">KAN −</button>
        <button class="rk" id="btn-next" type="button" aria-label="Næste kanal">KAN +</button>
      </div>
      <div class="remote__pad">
        {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => <button class="rk rk--n" type="button" data-n={n}>{n}</button>)}
        <button class="rk rk--n rk--rand" type="button" id="btn-rand" aria-label="Tilfældig kanal">?<span class="mob-l">Tilfældig</span></button>
        <button class="rk rk--n" type="button" data-n="0">0</button>
        <a class="rk rk--n rk--info" id="btn-info" href={first?.place ? `/sted/${first.place}` : "#"} aria-label="Læs anmeldelsen">i<span class="mob-l">Læs anmeldelsen</span></a>
      </div>
      <p class="remote__hint"><span class="hint-desk">Tast et afsnitsnummer, eller brug piletasterne. Enter afspiller.</span><span class="hint-mob">Swipe på skærmen for at zappe. Tryk for at se afsnittet.</span></p>
    </div>
  </section>

  {videos.length > 0 && (
    <div class="ticker" aria-label="Lige nu">
      <div class="ticker__track">
        {[0, 1].map((k) => (
          <p aria-hidden={k === 1 ? "true" : undefined}>
            <span>Nyeste afsnit: <b>{placeName(newest)}</b></span>
            {top && <span>Højeste karakter: <b>{placeName(top)} {fmtScore(top.score)}</b></span>}
            <span>Flest kommentarer: <b>{placeName(mostTalked)} ({fmtNum(mostTalked.comments)})</b></span>
            <span><b>{stats.videos}</b> afsnit, <b>{fmtNum(stats.total_views)}</b> visninger i alt</span>
          </p>
        ))}
      </div>
    </div>
  )}

  <section class="wrap meet" aria-labelledby="meet-h">
    <img class="meet__photo" src="/assets/dr-durum-rene.webp" alt="René med en dürüm" width="300" height="400" loading="lazy" />
    <div class="meet__text">
      <h2 id="meet-h" class="shout">Mød Dr. Dürüm</h2>
      <p>René står foran kameraet og spiser sig igennem byens dürüm, én rulle ad gangen. Jeppe filmer, ses aldrig og får som altid den ene halvdel.</p>
      <p>Over 8 er en <b>dum dürüm</b>: godkendt af KebabTV.</p>
      <a class="meet__cta" href="/hitlisten#nyeste"><img src="/assets/btn-seneste.webp" alt="Seneste anmeldelser" width="360" height="117" loading="lazy" /></a>
    </div>
    <img class="meet__sticker" src="/assets/logo-sticker.webp" alt="" width="260" height="256" loading="lazy" />
  </section>

  <section class="guide wrap" aria-labelledby="guide-h">
    <h2 id="guide-h" class="shout guide__h">Programoversigt</h2>
    {[...byYear].map(([year, list]) => (
      <div class="guide__year">
        <h3 class="guide__y"><button type="button" class="guide__toggle" aria-expanded="true">{year}<span class="guide__count">{list.length} afsnit</span></button></h3>
        <ol class="guide__list">
          {list.map((v) => (
            <li>
              <a class="gl" href={v.place ? `/sted/${v.place}` : `https://www.youtube.com/watch?v=${v.id}`}>
                <span class="gl__ep">{v.ep}</span>
                <span class="gl__name">{placeName(v)}</span>
                <span class="gl__meta">{fmtDate(v.date)}, {fmtDur(v.duration)}</span>
                <span class="gl__score" style={`--c:${scoreColor(v.score)};--i:${scoreInk(v.score)}`}>{fmtScore(v.score)}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <script type="application/json" id="chans" set:html={JSON.stringify(chans)} />
</Base>

<script>
  type Ch = { id: string; ep: number; thumb: string; name: string; sub: string; score: number | null; place: string | null };
  const chans: Ch[] = JSON.parse(document.getElementById("chans")?.textContent || "[]");
  const byEp = new Map(chans.map((c, i) => [c.ep, i]));
  const $ = (id: string) => document.getElementById(id)!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let idx = 0, typed = "", typeTimer = 0;

  const colors: [number, string, string][] = [[8.5, "#F3DC07", "#000"], [7.5, "#EDB10C", "#000"], [6.5, "#DE7414", "#000"], [5, "#C93118", "#fff"], [-1, "#730A03", "#fff"]];
  function paintScore(s: number | null) {
    const el = $("tv-score");
    const [, c, i] = s == null ? [0, "#fff", "#000"] : colors.find(([min]) => s >= min)!;
    el.style.setProperty("--c", c); el.style.setProperty("--i", i);
    $("tv-score-v").textContent = s == null ? "?" : s.toLocaleString("da-DK", { maximumFractionDigits: 1 });
  }

  // Analog snow on a tiny canvas, scaled up. Only runs during a zap.
  const cv = $("tv-static") as HTMLCanvasElement;
  const ctx = cv.getContext("2d")!;
  const img = ctx.createImageData(cv.width, cv.height);
  function snow(ms: number) {
    if (reduce) return Promise.resolve();
    cv.classList.add("on");
    const end = performance.now() + ms;
    return new Promise<void>((done) => {
      const frame = () => {
        const d = img.data;
        for (let p = 0; p < d.length; p += 4) { const g = Math.random() * 255; d[p] = d[p + 1] = d[p + 2] = g; d[p + 3] = 255; }
        ctx.putImageData(img, 0, 0);
        if (performance.now() < end) requestAnimationFrame(frame); else { cv.classList.remove("on"); done(); }
      };
      frame();
    });
  }

  function blink() { const l = $("led"); l.classList.add("on"); setTimeout(() => l.classList.remove("on"), 140); }

  async function tune(i: number) {
    if (!chans.length) return;
    idx = (i + chans.length) % chans.length;
    const c = chans[idx];
    blink();
    stop();
    $("tv-ch").textContent = String(c.ep);
    const pic = $("tv-img") as HTMLImageElement;
    const loaded = new Promise((r) => { const t = new Image(); t.onload = t.onerror = r; t.src = c.thumb; });
    await Promise.all([snow(260), loaded]);
    pic.src = c.thumb;
    $("tv-name").textContent = c.name;
    $("tv-sub").textContent = c.sub;
    paintScore(c.score);
    ($("btn-info") as HTMLAnchorElement).href = c.place ? `/sted/${c.place}` : `https://www.youtube.com/watch?v=${c.id}`;
    history.replaceState(null, "", `#${c.ep}`);
  }

  function play() {
    const c = chans[idx]; if (!c) return;
    const box = $("tv-player");
    box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${c.id}?autoplay=1&rel=0" title="${c.name.replace(/"/g, "")}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
    box.hidden = false;
    $("screen").classList.add("playing");
  }
  function stop() {
    const box = $("tv-player"); box.innerHTML = ""; box.hidden = true;
    $("screen").classList.remove("playing");
  }

  function typeDigit(n: string) {
    typed = (typed + n).slice(-3);
    $("tv-ch").textContent = typed + "–";
    blink();
    clearTimeout(typeTimer);
    typeTimer = window.setTimeout(() => {
      const target = byEp.get(Number(typed));
      typed = "";
      if (target != null) tune(target); else $("tv-ch").textContent = String(chans[idx].ep);
    }, 900);
  }

  $("btn-next").addEventListener("click", () => tune(idx - 1)); // newer episodes are earlier in the list
  $("btn-prev").addEventListener("click", () => tune(idx + 1));
  $("btn-play").addEventListener("click", play);
  $("btn-rand").addEventListener("click", () => tune(Math.floor(Math.random() * chans.length)));
  document.querySelectorAll<HTMLButtonElement>("[data-n]").forEach((b) => b.addEventListener("click", () => typeDigit(b.dataset.n!)));
  document.addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return;
    if (/^[0-9]$/.test(e.key)) typeDigit(e.key);
    else if (e.key === "ArrowUp" || e.key === "ArrowRight") { e.preventDefault(); tune(idx - 1); }
    else if (e.key === "ArrowDown" || e.key === "ArrowLeft") { e.preventDefault(); tune(idx + 1); }
    else if (e.key === "Enter" && document.activeElement === document.body) play();
    else if (e.key === "Escape") stop();
  });

  // Phones: swipe the screen to zap, tap to play.
  const screen = document.getElementById("screen");
  let sx = 0, sy = 0;
  screen?.addEventListener("touchstart", (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  screen?.addEventListener("touchend", (e) => {
    if (screen.classList.contains("playing")) return;
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) tune(dx < 0 ? idx - 1 : idx + 1);
    else if (Math.abs(dx) < 10 && Math.abs(dy) < 10) play();
  });

  // Phones: fold the programme guide by year, newest open.
  const phone = matchMedia("(max-width: 760px)");
  document.querySelectorAll<HTMLButtonElement>(".guide__toggle").forEach((b, i) => {
    const set = (open: boolean) => { b.setAttribute("aria-expanded", String(open)); b.closest(".guide__year")!.classList.toggle("is-closed", !open); };
    if (phone.matches && i > 0) set(false);
    b.addEventListener("click", () => { if (phone.matches) set(b.getAttribute("aria-expanded") !== "true"); });
  });

  const start = byEp.get(Number(location.hash.slice(1)));
  if (start != null && start !== 0) tune(start);
</script>

<style>
  .stage { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 40px; align-items: center; padding: 48px 0 40px; }

  /* ---------- The set ---------- */
  .tv {
    background: #1b1b1b; border: var(--line-fat); border-radius: 34px; padding: 26px 26px 0;
    box-shadow: inset 0 0 0 6px #2c2c2c, 10px 10px 0 var(--ink);
    animation: power 700ms cubic-bezier(.2,.8,.2,1) both;
  }
  @keyframes power { 0% { filter: brightness(.2); } 60% { filter: brightness(1.4); } 100% { filter: none; } }
  .tv__screen {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000;
    border: 4px solid #000; border-radius: 26px / 34px;
    container-type: inline-size;
  }
  .tv__img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.1) contrast(1.05); animation: screen-on 600ms 150ms both; }
  @keyframes screen-on { from { clip-path: inset(49.5% 0 49.5% 0); filter: brightness(4); } 50% { clip-path: inset(49.5% 0 49.5% 0); } to { clip-path: inset(0); } }
  .tv__glass { position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
    background:
      repeating-linear-gradient(0deg, rgba(0,0,0,.18) 0 1px, transparent 1px 3px),
      radial-gradient(120% 90% at 30% 20%, rgba(255,255,255,.14), transparent 45%),
      radial-gradient(140% 120% at 50% 50%, transparent 60%, rgba(0,0,0,.55));
  }
  .tv__static { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; opacity: 0; pointer-events: none; }
  .tv__static.on { opacity: 1; }
  .tv__player { position: absolute; inset: 0; z-index: 3; }
  .tv__player :global(iframe) { width: 100%; height: 100%; border: 0; }
  .playing .tv__glass { opacity: .35; }
  .playing .tv__score, .playing .tv__osd { display: none; }
  .tv__empty { color: var(--yellow); font-family: "VT323", monospace; font-size: 1.6rem; padding: 2rem; margin: 0; }

  .tv__osd { position: absolute; top: 5cqw; right: 6cqw; font-family: var(--display); font-size: 5cqw; color: #7CFF5B;
    text-shadow: 0 0 6px rgba(124,255,91,.7), 2px 2px 0 #000; letter-spacing: .04em; }
  .tv__osd span { font-size: .6em; }

  .tv__score { position: absolute; left: 4cqw; top: 4cqw; width: 12cqw; aspect-ratio: 1; border-radius: 50%;
    background: var(--c); color: var(--i); border: .8cqw solid #000; display: grid; place-items: center;
    font-family: var(--display); font-size: 5cqw; box-shadow: .6cqw .6cqw 0 #000; rotate: -8deg; }

  .tv__chin { display: flex; align-items: center; gap: 14px; height: 58px; padding: 0 8px; }
  .tv__now { margin: 0 auto 0 4px; min-width: 0; color: #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .95rem; }
  .tv__now b { font-family: var(--display); font-weight: 400; color: var(--yellow); font-size: 1.25rem; letter-spacing: .02em; margin-right: 6px; }
  .tv__knob { width: 30px; height: 30px; border-radius: 50%; background: conic-gradient(#555, #222, #555, #222, #555); border: 3px solid #000; }

  /* ---------- Remote ---------- */
  .remote { background: #232323; border: var(--line-fat); border-radius: 40px 40px 30px 30px; padding: 22px 16px 18px;
    box-shadow: inset 0 0 0 4px #333, var(--drop); display: flex; flex-direction: column; align-items: center; gap: 14px; rotate: 3deg; }
  .remote__led { width: 10px; height: 10px; border-radius: 50%; background: #3a0b06; border: 2px solid #000; }
  .remote__led:global(.on) { background: #ff3b1f; box-shadow: 0 0 10px #ff3b1f; }
  .rk { font-family: var(--display); border: 3px solid #000; background: #e9e9e9; color: #000; border-radius: 12px; cursor: pointer;
    box-shadow: 0 4px 0 #000; padding: 8px 0; text-decoration: none; text-align: center; display: grid; place-items: center; }
  .rk:active { translate: 0 3px; box-shadow: 0 1px 0 #000; }
  .rk--ok { width: 74px; height: 74px; border-radius: 50%; background: var(--red); color: #fff; font-size: 1.8rem; }
  .rk--ok:hover { background: #e03c20; }
  .remote__row { display: flex; gap: 8px; width: 100%; }
  .remote__row .rk { flex: 1; background: var(--yellow); font-size: 1rem; }
  .remote__pad { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 100%; }
  .rk--n { font-size: 1.25rem; min-width: 0; padding: 0; height: 44px; border-radius: 50%; }
  .rk--rand, .rk--info { background: #bdbdbd; }
  .rk--info { font-family: var(--serif); font-style: italic; font-weight: 800; }
  .remote__hint { color: #bbb; font-size: .74rem; line-height: 1.35; margin: 0; text-align: center; }

  /* ---------- Ticker ---------- */
  .ticker { background: var(--ink); color: var(--paper); border-block: 4px solid var(--ink); overflow: hidden; box-shadow: 0 4px 0 var(--red); }
  .ticker__track { display: flex; width: max-content; animation: tick 50s linear infinite; }
  .ticker:hover .ticker__track { animation-play-state: paused; }
  .ticker p { margin: 0; display: flex; }
  .ticker span { padding: 10px 28px; white-space: nowrap; border-right: 2px solid #333; }
  .ticker b { color: var(--yellow); font-weight: 600; }
  @keyframes tick { to { transform: translateX(-50%); } }

  /* ---------- Meet ---------- */
  .meet { position: relative; display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 40px; align-items: center; padding: 64px 0 24px; overflow: hidden; }
  .meet__photo { width: 300px; height: auto; filter: drop-shadow(6px 6px 0 #000); }
  .meet__text h2 { font-size: var(--t-6); margin-bottom: 16px; }
  .meet__text p { font-size: var(--t-2); max-width: 46ch; margin: 0 0 12px; }
  .meet__cta { display: inline-block; line-height: 0; margin-top: 10px; transition: transform .15s; }
  .meet__cta img { width: 360px; height: auto; }
  .meet__cta:hover { transform: rotate(-2deg) scale(1.03); }
  /* Logo sticker peeks in from the corner; its bottom text stays out of frame. */
  .meet__sticker { position: absolute; right: -40px; bottom: -150px; width: 260px; height: auto; rotate: 16deg; opacity: .95; pointer-events: none; }

  /* ---------- Guide ---------- */
  .guide { padding-top: 56px; }
  .guide__h { font-size: var(--t-6); margin-bottom: 24px; }
  .guide__year { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; border-top: var(--line); padding: 18px 0; }
  .guide__y { font-family: var(--display); font-size: var(--t-5); margin: 0; line-height: 1; font-weight: 400; }
  .guide__toggle { all: unset; cursor: default; }
  .guide__count, .mob-l, .hint-mob { display: none; }
  .guide__list { list-style: none; margin: 0; padding: 0; columns: 2 340px; column-gap: 32px; }
  .guide__list li { break-inside: avoid; }
  .gl { display: grid; grid-template-columns: 3.2em minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: 12px;
    text-decoration: none; padding: 7px 0; border-bottom: 2px dotted rgba(0,0,0,.35); align-items: center; }
  .gl:hover .gl__name { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 3px; }
  .gl__ep { grid-row: span 2; font-family: var(--display); font-size: var(--t-3); color: var(--oxblood); text-align: right; }
  .gl__name { font-weight: 600; line-height: 1.2; }
  .gl__meta { grid-column: 2; font-size: var(--t-0); opacity: .75; }
  .gl__score { grid-row: 1 / span 2; grid-column: 3; min-width: 2.6em; text-align: center; font-family: var(--display);
    background: var(--c); color: var(--i); border: 2px solid #000; border-radius: 999px; padding: 1px 8px; }

  @media (max-width: 860px) {
    .stage { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-top: 28px; }
    .tv { padding: 14px 14px 0; border-radius: 24px; }
    .tv__chin { height: 42px; }
    .remote { rotate: 0deg; border-radius: 26px; display: grid; grid-template-columns: auto 1fr; grid-template-areas: "ok row" "pad pad" "hint hint"; align-items: center; }
    .remote__led { display: none; }
    .rk--ok { grid-area: ok; }
    .remote__row { grid-area: row; }
    .remote__pad { grid-area: pad; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .remote__hint { grid-area: hint; }
    .guide__year { grid-template-columns: 1fr; gap: 8px; }
    .meet { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .meet__photo { width: 200px; }
    .meet__text h2 { font-size: var(--t-5); }
    .meet__cta img { width: 280px; }
    .meet__sticker { width: 160px; bottom: -90px; right: -30px; }
  }

  /* ---------- Phones ---------- */
  @media (max-width: 760px) {
    .stage { padding: 16px 0 24px; gap: 18px; }
    .tv { padding: 10px 10px 0; border-radius: 20px; box-shadow: inset 0 0 0 4px #2c2c2c, 6px 6px 0 var(--ink); }
    .tv__screen { border-radius: 16px / 22px; touch-action: pan-y; }
    .tv__chin { height: 40px; gap: 8px; }
    .tv__now b { font-size: 1.1rem; }
    .tv__knob { width: 22px; height: 22px; }

    /* Compact remote: CH- / play / CH+, then random + read. Number pad hidden. */
    .remote { grid-template-columns: 1fr auto 1fr; grid-template-areas: "prev ok next" "rand info info" "hint hint hint";
      gap: 10px; padding: 14px; border-radius: 22px; }
    .remote__row, .remote__pad { display: contents; }
    #btn-prev { grid-area: prev; } #btn-next { grid-area: next; }
    #btn-rand { grid-area: rand; } #btn-info { grid-area: info; }
    .rk--ok { width: 66px; height: 66px; }
    .remote__row .rk { font-size: 1.05rem; min-height: 50px; }
    .rk--n[data-n] { display: none; }
    .rk--rand, .rk--info { aspect-ratio: auto; height: 46px; border-radius: 999px; display: flex; gap: 8px; justify-content: center; font-size: 1rem; }
    .rk--info { font-family: var(--display); font-style: normal; background: var(--yellow); }
    .mob-l { display: inline; font-family: var(--display); font-style: normal; font-weight: 400; white-space: nowrap; }
    .hint-desk { display: none; }
    .hint-mob { display: inline; }

    .ticker span { padding: 8px 18px; font-size: .9rem; }

    .meet { padding-top: 40px; }
    .meet__text h2 { font-size: 2.4rem; }
