---
import Base from "../layouts/Base.astro";
import { places, videoById, fmtScore, scoreColor, scoreInk } from "../lib/data";

const pins = places.filter((p) => p.geo).map((p) => {
  const v = videoById.get(p.latest);
  return {
    slug: p.slug, name: p.name, lat: p.geo!.lat, lng: p.geo!.lng, score: p.score,
    sub: p.address || p.area || "", area: p.area || "Ukendt",
    c: scoreColor(p.score), i: scoreInk(p.score), label: fmtScore(p.score),
    thumb: v?.thumb ?? "",
  };
});
const missing = places.length - pins.length;
const areas = [...new Set(pins.map((p) => p.area))].sort((a, b) => a.localeCompare(b, "da"));
---
<Base title="Kebab-kortet" channel={3} bodyClass="mapbody">
  <div class="mapwrap">
    <aside class="panel">
      <div class="maptitle">
        <img src="/assets/pin.webp" alt="" width="64" height="60" />
        <h1 class="shout">Kebab-kortet</h1>
      </div>
      <p class="lede">
        {pins.length} steder på kortet. Farven er karakteren: jo mere gul, jo bedre.
        {missing > 0 && ` ${missing} steder mangler en adresse endnu.`}
      </p>
      <div class="cities" role="group" aria-label="Hop til by">
        <button class="btn" type="button" data-city="kbh" aria-pressed="true">København</button>
        <button class="btn" type="button" data-city="aar" aria-pressed="false">Aarhus</button>
        <button class="btn" type="button" id="near">Tæt på mig</button>
      </div>
      <div class="filters">
        <label>
          <span>Bydel</span>
          <select id="area">
            <option value="">Alle bydele</option>
            {areas.map((a) => <option value={a}>{a}</option>)}
          </select>
        </label>
        <label>
          <span>Mindst karakter <output id="minv">0</output></span>
          <input id="min" type="range" min="0" max="10" step="0.5" value="0" />
        </label>
      </div>
      <ol class="plist" id="plist">
        {[...pins].sort((a, b) => (b.score ?? -1) - (a.score ?? -1)).map((p) => (
          <li data-slug={p.slug} data-area={p.area} data-score={p.score ?? -1}>
            <button type="button" class="pitem">
              <span class="pitem__dot" style={`--c:${p.c};--i:${p.i}`}>{p.label}</span>
              <span class="pitem__name">{p.name}</span>
              <span class="pitem__sub">{p.sub}</span>
            </button>
          </li>
        ))}
      </ol>
    </aside>
    <div id="map" class="map" role="region" aria-label="Kort over anmeldte steder"></div>
  </div>
  <script type="application/json" id="pins" set:html={JSON.stringify(pins)} />
</Base>

<script>
  import * as maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  // Worker + its shared chunk are copied to /public/maplibre by copy-maplibre.mjs.
  maplibregl.setWorkerUrl("/maplibre/maplibre-gl-worker.mjs");
  type Pin = { slug: string; name: string; lat: number; lng: number; score: number | null; sub: string; area: string; c: string; i: string; label: string; thumb: string };
  const pins: Pin[] = JSON.parse(document.getElementById("pins")!.textContent || "[]");

  const map = new maplibregl.Map({
    container: "map",
    style: "https://tiles.openfreemap.org/styles/positron",
    center: [12.555, 55.68], zoom: 11.6, attributionControl: { compact: true },
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");

  // Repaint the basemap in the channel's colors: yellow land, ink water, white streets.
  map.on("style.load", () => {
    for (const layer of map.getStyle().layers) {
      const id = layer.id;
      try {
        if (layer.type === "background") map.setPaintProperty(id, "background-color", "#F6E74E");
        else if (/water/.test(id) && layer.type === "fill") map.setPaintProperty(id, "fill-color", "#000000");
        else if (/water/.test(id) && layer.type === "line") map.setPaintProperty(id, "line-color", "#000000");
        else if (/park|landcover|landuse|wood|grass/.test(id) && layer.type === "fill") map.setPaintProperty(id, "fill-color", "#EAD63A");
        else if (/building/.test(id) && layer.type === "fill") map.setPaintProperty(id, "fill-color", "#E2CC2E");
        else if (/road|highway|street|bridge|tunnel/.test(id) && layer.type === "line") map.setPaintProperty(id, "line-color", "#FFFFFF");
        else if (/rail/.test(id) && layer.type === "line") map.setPaintProperty(id, "line-color", "#730A03");
        else if (layer.type === "symbol") {
          map.setPaintProperty(id, "text-color", "#000000");
          map.setPaintProperty(id, "text-halo-color", "#F6E74E");
        }
      } catch { /* layer without that property */ }
    }
  });

  const markers = new Map<string, maplibregl.Marker>();
  for (const p of pins) {
    const el = document.createElement("button");
    el.className = "pin";
    el.type = "button";
    el.style.setProperty("--c", p.c);
    el.style.setProperty("--i", p.i);
    el.textContent = p.label;
    el.setAttribute("aria-label", `${p.name}, karakter ${p.label}`);
    const pop = new maplibregl.Popup({ offset: 26, closeButton: false, maxWidth: "280px" }).setHTML(
      `<a class="pop" href="/sted/${p.slug}">
         ${p.thumb ? `<img src="${p.thumb}" alt="" width="256" height="144">` : ""}
         <span class="pop__name">${p.name}</span>
         <span class="pop__sub">${p.sub}</span>
         <span class="pop__go">Læs anmeldelsen</span>
       </a>`,
    );
    markers.set(p.slug, new maplibregl.Marker({ element: el }).setLngLat([p.lng, p.lat]).setPopup(pop).addTo(map));
  }

  function focus(slug: string) {
    const p = pins.find((x) => x.slug === slug); if (!p) return;
    map.flyTo({ center: [p.lng, p.lat], zoom: 15, speed: 1.4 });
    const m = markers.get(slug)!;
    if (!m.getPopup()!.isOpen()) m.togglePopup();
  }
  document.querySelectorAll<HTMLLIElement>("#plist li").forEach((li) =>
    li.querySelector("button")!.addEventListener("click", () => focus(li.dataset.slug!)),
  );

  const area = document.getElementById("area") as HTMLSelectElement;
  const min = document.getElementById("min") as HTMLInputElement;
  const minv = document.getElementById("minv")!;
  function filter() {
    minv.textContent = min.value.replace(".", ",");
    const a = area.value, m = +min.value;
    for (const p of pins) {
      const show = (!a || p.area === a) && (m === 0 || (p.score ?? -1) >= m);
      markers.get(p.slug)!.getElement().style.display = show ? "" : "none";
      (document.querySelector(`#plist li[data-slug="${p.slug}"]`) as HTMLElement).hidden = !show;
    }
  }
  area.addEventListener("change", filter);
  min.addEventListener("input", filter);

  // Most places are in Copenhagen; Aarhus gets its own button.
  const inAarhus = (p: Pin) => p.lng < 11 && p.lat > 55.9;
  function showCity(city: string, animate = true) {
    const set = pins.filter((p) => (city === "aar" ? inAarhus(p) : !inAarhus(p)));
    document.querySelectorAll("[data-city]").forEach((b) => b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.city === city)));
    if (!set.length) return;
    const b = new maplibregl.LngLatBounds();
    set.forEach((p) => b.extend([p.lng, p.lat]));
    map.fitBounds(b, { padding: 70, maxZoom: 14, duration: animate ? 900 : 0 });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-city]").forEach((b) => b.addEventListener("click", () => showCity(b.dataset.city!)));

  // "Tæt på mig": ask for location, drop a marker, sort the list by distance.
  const nearBtn = document.getElementById("near") as HTMLButtonElement;
  function nearMe() {
    if (!navigator.geolocation) { nearBtn.textContent = "Kan ikke finde dig"; return; }
    nearBtn.textContent = "Finder dig …";
    navigator.geolocation.getCurrentPosition((pos) => {
      const me: [number, number] = [pos.coords.longitude, pos.coords.latitude];
      const el = document.createElement("div"); el.className = "me"; el.setAttribute("aria-label", "Dig");
      new maplibregl.Marker({ element: el }).setLngLat(me).addTo(map);
      const dist = (p: Pin) => Math.hypot((p.lng - me[0]) * Math.cos(me[1] * Math.PI / 180), p.lat - me[1]) * 111;
      const list = document.getElementById("plist")!;
      [...list.children].sort((a, b) => dist(pins.find((p) => p.slug === (a as HTMLElement).dataset.slug)!) - dist(pins.find((p) => p.slug === (b as HTMLElement).dataset.slug)!))
        .forEach((li) => list.appendChild(li));
      const closest = [...pins].sort((a, b) => dist(a) - dist(b)).slice(0, 5);
      const b = new maplibregl.LngLatBounds(me, me); closest.forEach((p) => b.extend([p.lng, p.lat]));
      map.fitBounds(b, { padding: 80, maxZoom: 15 });
      nearBtn.textContent = `Nærmeste: ${Math.round(dist(closest[0]) * 10) / 10} km`;
    }, () => { nearBtn.textContent = "Adgang nægtet"; }, { enableHighAccuracy: true, timeout: 10000 });
  }
  nearBtn.addEventListener("click", nearMe);

  const start = location.hash.slice(1);
  if (start === "naer") { showCity("kbh", false); nearMe(); }
  else if (start) map.once("load", () => focus(start));
  else showCity("kbh", false);
</script>

<style>
  .mapwrap { display: grid; grid-template-columns: 360px minmax(0, 1fr); height: calc(100vh - 81px); min-height: 520px; }
  .panel { overflow-y: auto; padding: 28px 22px; border-right: var(--line-fat); background: var(--yellow-2); }
  h1 { font-size: 3.2rem; }
  .maptitle { display: flex; align-items: center; gap: 10px; }
  .maptitle img { width: 58px; height: auto; rotate: -10deg; filter: drop-shadow(3px 3px 0 #000); }
  .cities { flex-wrap: wrap; }
  :global(.me) { width: 22px; height: 22px; border-radius: 50%; background: #1f5cff; border: 4px solid #fff; box-shadow: 0 0 0 3px #000, 0 0 0 10px rgba(31,92,255,.25); }
  .lede { margin: 12px 0 18px; }
  .cities { display: flex; gap: 8px; margin-bottom: 18px; }
  .cities .btn { font-size: 1rem; }
  .filters { display: grid; gap: 12px; margin-bottom: 18px; }
  .filters label { display: grid; gap: 4px; font-weight: 600; font-size: var(--t-0); }
  .filters select { font: inherit; font-size: 1rem; padding: 8px 10px; border: var(--line); border-radius: 10px; background: var(--paper); box-shadow: var(--drop-sm); }
  .filters input[type="range"] { accent-color: #000; }
  .plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pitem { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; display: grid; grid-template-columns: 44px 1fr; gap: 0 10px; align-items: center;
    padding: 6px 10px 6px 6px; border-radius: 999px; border: 2px solid transparent; }
  .pitem:hover, .pitem:focus-visible { background: var(--paper); border-color: #000; }
  .pitem__dot { grid-row: span 2; width: 40px; height: 40px; border-radius: 50%; background: var(--c); color: var(--i); border: 3px solid #000;
    display: grid; place-items: center; font-family: var(--display); font-size: .95rem; }
  .pitem__name { font-weight: 600; line-height: 1.15; }
  .pitem__sub { font-size: var(--t-0); opacity: .75; line-height: 1.2; }
  .map { position: relative; }

  :global(.pin) { width: 38px; height: 38px; border-radius: 50%; background: var(--c); color: var(--i); border: 3px solid #000; cursor: pointer;
    font-family: var(--display); font-size: .95rem; box-shadow: 2px 3px 0 #000; padding: 0; }
  :global(.pin:hover) { width: 44px; height: 44px; z-index: 5; }
  :global(.maplibregl-popup-content) { border: 3px solid #000; border-radius: 16px; box-shadow: var(--drop-sm); padding: 8px; }
  :global(.pop) { display: grid; gap: 4px; text-decoration: none; color: #000; font-family: var(--serif); }
  :global(.pop img) { border-radius: 10px; border: 2px solid #000; width: 100%; height: auto; }
  :global(.pop__name) { font-family: var(--display); font-size: 1.4rem; line-height: 1; margin-top: 4px; }
  :global(.pop__sub) { font-size: .85rem; }
  :global(.pop__go) { justify-self: start; background: #000; color: var(--yellow); font-family: var(--display); padding: 3px 12px; border-radius: 999px; margin-top: 4px; }

  @media (max-width: 800px) {
    .mapwrap { grid-template-columns: 1fr; grid-template-rows: 60vh auto; height: auto; }
    .map { order: -1; border-bottom: var(--line-fat); }
    .panel { border-right: 0; overflow: visible; }
  }
</style>
