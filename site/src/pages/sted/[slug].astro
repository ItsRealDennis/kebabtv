---
import Base from "../../layouts/Base.astro";
import LowerThird from "../../components/LowerThird.astro";
import { places, videoById, fmtDate, fmtNum, fmtScore, fmtTime, scoreColor, scoreInk, isDumDurum, type Place } from "../../lib/data";

export function getStaticPaths() {
  return places.map((p) => ({ params: { slug: p.slug }, props: { place: p } }));
}
const { place } = Astro.props as { place: Place };
const visits = place.videos.map((id) => videoById.get(id)!).filter(Boolean);
const main = visits[0];
const r = main.review;
const rating = r.rating ?? {};
const vw = main.viewers;
const sub = place.address || [place.area, place.city].filter(Boolean).join(", ");
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([place.name, place.address, place.city || "København"].filter(Boolean).join(", "))}`;
// Keep the viewer quote short; cut at a word boundary.
const shortComment = (() => {
  const t = vw?.best_comment?.trim();
  if (!t) return null;
  const words = t.split(/\s+/);
  return words.length <= 40 ? t : words.slice(0, 40).join(" ") + " …";
})();
const verdictWord = vw?.agrees_with_rating === true ? "Seerne er enige" : vw?.agrees_with_rating === false ? "Seerne er uenige" : "Seerne er delte";
---
<Base title={place.name} channel={2} description={r.verdict_short ?? `KebabTV anmelder ${place.name}.`}>
  <section class="wrap hero">
    <LowerThird name={place.name} sub={sub || fmtDate(main.date)} size="lg" tag="h1" />
    <div class="stamp" style={`--c:${scoreColor(place.score)};--i:${scoreInk(place.score)}`} aria-label={`Karakter ${fmtScore(place.score)} ud af 10`}>
      <span class="stamp__v">{fmtScore(place.score)}</span>
      <span class="stamp__of">ud af 10</span>
    </div>
    {isDumDurum(place.score) && (
      <img class="dd" src="/assets/stamp-dum-durum.webp" width="150" height="146" alt="Dum dürüm: over 8, godkendt af KebabTV" title="Over 8: dum dürüm, approved af KebabTV" />
    )}
  </section>

  <section class="wrap body">
    <div class="col-main">
      <div class="player" id="player" data-id={main.id}>
        <button class="player__poster" id="poster" type="button" aria-label={`Afspil: ${main.title}`}>
          <img src={main.thumb} alt="" width="1280" height="720" />
          <span class="player__btn" aria-hidden="true">▶</span>
        </button>
      </div>
      <p class="caption">
        <a href={`https://www.youtube.com/watch?v=${main.id}`}>{main.title}</a><br />
        {fmtDate(main.date)}. {fmtNum(main.views)} visninger, {fmtNum(main.comments)} kommentarer.
      </p>

      {r.stub ? (
        <p class="pending">Anmeldelsen er ikke læst endnu. Karakter, citater og seernes mening kommer, når botten har kørt analysen.</p>
      ) : (
        <>
          {r.verdict_short && <p class="verdict">“{r.verdict_short}”</p>}
          {r.summary && <p class="summary">{r.summary}</p>}

          {r.quotes && r.quotes.length > 0 && (
            <div class="block">
              <h2 class="h2">Det blev sagt</h2>
              <ul class="quotes">
                {r.quotes.map((q) => (
                  <li>
                    <button class="quote" type="button" data-t={q.t}>
                      <span class="quote__t">{fmtTime(q.t)}</span>
                      <span class="quote__text">{q.text}</span>
                      {q.speaker && <span class="quote__who">{q.speaker}</span>}
                    </button>
                  </li>
                ))}
                {rating.raw_quote && rating.t != null && (
                  <li>
                    <button class="quote quote--score" type="button" data-t={rating.t}>
                      <span class="quote__t">{fmtTime(rating.t)}</span>
                      <span class="quote__text">Her falder karakteren: “{rating.raw_quote}”</span>
                    </button>
                  </li>
                )}
              </ul>
            </div>
          )}

          {(r.pros?.length || r.cons?.length) ? (
            <div class="block pc">
              <div>
                <h2 class="h2">Godt</h2>
                <ul class="pc__list pc__list--pro">{r.pros?.map((p) => <li>{p}</li>)}</ul>
              </div>
              <div>
                <h2 class="h2">Mindre godt</h2>
                <ul class="pc__list pc__list--con">{r.cons?.map((c) => <li>{c}</li>)}</ul>
              </div>
            </div>
          ) : null}
        </>
      )}
    </div>

    <aside class="col-side">
      <dl class="facts">
        {r.dish && <><dt>Ret</dt><dd>{r.dish}</dd></>}
        {r.price_dkk && <><dt>Pris</dt><dd>{r.price_dkk} kr.</dd></>}
        {rating.value != null && <><dt>Deres karakter</dt><dd>{fmtScore(rating.value)} / {rating.scale ?? 10}</dd></>}
        {r.sub_scores?.map((s) => <><dt>{s.label}</dt><dd>{fmtScore(s.value)} / {s.scale}</dd></>)}
        {r.people && r.people.length > 0 && <><dt>I billedet</dt><dd>{r.people.join(", ")}</dd></>}
        <dt>Find vej</dt><dd><a href={mapsUrl}>Åbn i Google Maps</a>{place.geo && <>, eller <a href={`/kortet#${place.slug}`}>se på kebab-kortet</a></>}</dd>
      </dl>

      {vw && (
        <div class="crowd">
          <h2 class="h2">{verdictWord}</h2>
          <div class="meter" role="img" aria-label={`${vw.positive_pct}% positive, ${vw.neutral_pct}% neutrale, ${vw.negative_pct}% negative kommentarer`}>
            <span style={`flex:${vw.positive_pct}`} class="m-pos">{vw.positive_pct >= 12 && `${vw.positive_pct}%`}</span>
            <span style={`flex:${vw.neutral_pct}`} class="m-neu"></span>
            <span style={`flex:${vw.negative_pct}`} class="m-neg">{vw.negative_pct >= 12 && `${vw.negative_pct}%`}</span>
          </div>
          <p class="meter__key"><span class="k k-pos"></span>positive <span class="k k-neu"></span>neutrale <span class="k k-neg"></span>negative</p>
          {vw.disagreement_note && <p class="crowd__note">{vw.disagreement_note}</p>}
          {shortComment && (
            <figure class="bubble">
              <blockquote>{shortComment}</blockquote>
              {vw.best_comment_author && <figcaption>{vw.best_comment_author}</figcaption>}
            </figure>
          )}
          {vw.themes && vw.themes.length > 0 && (
            <>
              <h3 class="h3">Det snakker de om</h3>
              <ul class="themes">{vw.themes.map((t) => <li>{t.label}</li>)}</ul>
            </>
          )}
        </div>
      )}

      {visits.length > 1 && (
        <div class="visits">
          <h2 class="h2">Alle besøg</h2>
          <ol>
            {visits.map((v) => (
              <li><a href={`https://www.youtube.com/watch?v=${v.id}`}>{fmtDate(v.date)}</a>, karakter {fmtScore(v.score)}</li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </section>
</Base>

<script>
  // Lazy YouTube embed; quotes seek the player via the IFrame API.
  declare const YT: any;
  const host = document.getElementById("player");
  let player: any = null;
  let pendingSeek: number | null = null;

  function loadApi(): Promise<void> {
    if ((window as any).YT?.Player) return Promise.resolve();
    return new Promise((res) => {
      (window as any).onYouTubeIframeAPIReady = () => res();
      const s = document.createElement("script");
      s.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(s);
    });
  }
  async function start(at = 0) {
    if (!host) return;
    if (player) { player.seekTo(at, true); player.playVideo(); return; }
    pendingSeek = at;
    await loadApi();
    const mount = document.createElement("div");
    host.replaceChildren(mount);
    player = new YT.Player(mount, {
      videoId: host.dataset.id, host: "https://www.youtube-nocookie.com",
      playerVars: { autoplay: 1, rel: 0, start: Math.floor(pendingSeek ?? 0) },
      events: { onReady: (e: any) => e.target.playVideo() },
    });
  }
  document.getElementById("poster")?.addEventListener("click", () => start(0));
  document.querySelectorAll<HTMLButtonElement>(".quote").forEach((b) =>
    b.addEventListener("click", () => {
      start(Number(b.dataset.t));
      host?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
    }),
  );
</script>

<style>
  .hero { position: relative; padding: 64px 0 36px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .stamp { flex: none; width: 150px; height: 150px; border-radius: 50%; background: var(--c); color: var(--i); border: 6px solid #000;
    display: grid; place-content: center; text-align: center; box-shadow: var(--drop); rotate: 10deg;
    outline: 3px dashed #000; outline-offset: -16px; }
  .stamp__v { font-family: var(--display); font-size: 3.6rem; line-height: .9; }
  .stamp__of { font-size: .8rem; font-weight: 600; }
  /* Their own "dum dürüm" approval badge. */
  .dd { position: absolute; right: 160px; top: 24px; width: 150px; height: auto; rotate: -10deg; filter: drop-shadow(4px 4px 0 #000); }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; align-items: start; }
  .player { aspect-ratio: 16/9; border: var(--line-fat); box-shadow: var(--drop); background: #000; border-radius: 18px; overflow: hidden; }
  .player :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .player__poster { all: unset; cursor: pointer; position: relative; display: block; width: 100%; height: 100%; }
  .player__poster img { width: 100%; height: 100%; object-fit: cover; }
  .player__poster:focus-visible { outline: 4px solid var(--red); outline-offset: -8px; }
  .player__btn { position: absolute; inset: 0; margin: auto; width: 96px; height: 96px; border-radius: 50%; background: var(--red); color: #fff;
    border: 5px solid #000; display: grid; place-items: center; font-size: 2.4rem; box-shadow: var(--drop-sm); }
  .player__poster:hover .player__btn { background: var(--yellow); color: #000; }
  .caption { font-size: var(--t-0); margin: 14px 0 0; }
  .pending { margin-top: 32px; font-size: var(--t-2); background: var(--paper); border: var(--line); padding: 16px 20px; box-shadow: var(--drop-sm); max-width: 60ch; }

  .verdict { font-family: var(--display); font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.05; margin: 40px 0 12px; max-width: 22ch; }
  .summary { font-size: var(--t-2); line-height: 1.55; max-width: 62ch; margin: 0; }
  .block { margin-top: 44px; }
  .h2 { font-family: var(--display); font-weight: 400; font-size: var(--t-4); margin: 0 0 14px; line-height: 1; }
  .h3 { font-family: var(--display); font-weight: 400; font-size: var(--t-2); margin: 20px 0 8px; }

  .quotes { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .quote { all: unset; box-sizing: border-box; cursor: pointer; display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; width: 100%;
    background: var(--paper); border: var(--line); border-radius: 16px; padding: 14px 18px; box-shadow: var(--drop-sm); }
  .quote:hover { background: var(--yellow); }
  .quote:focus-visible { outline: 4px solid var(--red); outline-offset: 3px; }
  .quote__t { grid-row: span 2; font-family: var(--display); background: #000; color: var(--yellow); border-radius: 999px; padding: 2px 10px; align-self: start; }
  .quote__text { font-size: var(--t-2); line-height: 1.35; font-style: italic; }
  .quote__who { font-size: var(--t-0); font-weight: 600; }
  .quote--score { background: var(--ink); color: var(--paper); }
  .quote--score .quote__t { background: var(--yellow); color: #000; }
  .quote--score:hover { background: var(--oxblood); }

  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .pc__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .pc__list li { padding-left: 30px; position: relative; line-height: 1.4; }
  .pc__list li::before { position: absolute; left: 0; top: .05em; width: 20px; height: 20px; border-radius: 50%; border: 2px solid #000;
    display: grid; place-items: center; font-family: var(--serif); font-weight: 800; font-size: 1rem; line-height: 1; }
  .pc__list--pro li::before { content: "+"; background: var(--yellow); }
  .pc__list--con li::before { content: "−"; background: var(--red); color: #fff; }

  .facts { margin: 0; background: var(--paper); border: var(--line); box-shadow: var(--drop); padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; }
  .facts dt { font-weight: 600; font-size: var(--t-0); padding-top: 3px; }
  .facts dd { margin: 0; }

  .crowd { margin-top: 32px; }
  .meter { display: flex; height: 34px; border: var(--line); border-radius: 999px; overflow: hidden; box-shadow: var(--drop-sm); font-family: var(--display); }
  .meter span { display: grid; place-items: center; min-width: 0; }
  .m-pos, .k-pos { background: var(--yellow); }
  .m-neu, .k-neu { background: var(--paper); }
  .m-neg, .k-neg { background: var(--red); color: #fff; }
  .meter span + span { border-left: 3px solid #000; }
  .meter__key { font-size: var(--t-0); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin: 8px 0 0; }
  .k { width: 12px; height: 12px; border: 2px solid #000; border-radius: 50%; display: inline-block; margin-left: 6px; }
  .k:first-child { margin-left: 0; }
  .crowd__note { font-size: .95rem; margin: 14px 0 0; }
  .bubble { position: relative; margin: 22px 0 0; background: var(--paper); border: var(--line); border-radius: 22px; padding: 16px 18px; box-shadow: var(--drop-sm); }
  .bubble::after { content: ""; position: absolute; left: 28px; bottom: -16px; width: 22px; height: 22px; background: var(--paper);
    border-right: var(--line); border-bottom: var(--line); transform: skewX(30deg) rotate(45deg); }
  .bubble blockquote { margin: 0; font-style: italic; }
  .bubble figcaption { position: absolute; bottom: -34px; left: 60px; font-size: var(--t-0); font-weight: 600; }
  .themes { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .crowd .h3 { margin-top: 48px; }
  .themes li { border: 2px solid #000; border-radius: 999px; padding: 2px 12px; background: var(--paper); font-size: .9rem; }
  .visits { margin-top: 32px; }

  @media (max-width: 900px) {
    .hero { flex-direction: column; align-items: flex-start; padding-top: 40px; }
    .stamp { position: absolute; right: 0; top: 16px; width: 104px; height: 104px; }
    .stamp__v { font-size: 2.4rem; }
    .dd { position: static; align-self: flex-end; width: 104px; margin-top: -12px; }
    .body { grid-template-columns: 1fr; }
    .pc { grid-template-columns: 1fr; }
  }
  /* Phones: name full width, then score + dum dürüm side by side. */
  @media (max-width: 760px) {
    .hero { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 14px 18px; padding: 26px 0 22px; }
    .hero :global(.lt) { flex: 1 1 100%; --lt-d: 104px; --lt-f: clamp(1.9rem, 9vw, 2.6rem); }
    .hero :global(.lt__sub) { font-size: .95rem; margin-top: .6rem; }
    .hero :global(.lt__durum img) { width: 74px; height: auto; }
    .hero :global(.lt__durum) { left: -4px; translate: 0 -58%; }
    .stamp { position: static; width: 96px; height: 96px; rotate: -6deg; outline-offset: -11px; border-width: 5px; }
    .stamp__v { font-size: 2.3rem; }
    .stamp__of { font-size: .68rem; }
    .dd { position: static; width: 98px; margin: 0; rotate: 8deg; align-self: center; }
    .body { gap: 28px; }
    .player { border-radius: 14px; box-shadow: 4px 4px 0 #000; }
    .player__btn { width: 72px; height: 72px; font-size: 1.8rem; }
    .verdict { font-size: 1.7rem; margin-top: 24px; }
    .summary { font-size: 1.05rem; }
    .block { margin-top: 32px; }
    .h2 { font-size: 1.7rem; }
    .quote { padding: 12px 14px; gap: 4px 10px; }
    .quote__text { font-size: 1.05rem; }
    .facts { grid-template-columns: 1fr; gap: 2px; box-shadow: 4px 4px 0 #000; }
    .facts dt { padding-top: 8px; }
    .bubble figcaption { position: static; margin-top: 18px; }
    .crowd .h3 { margin-top: 24px; }
  }
</style>
